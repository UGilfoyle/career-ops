{
  "name": "career-ops",
  "version": "1.12.0",
  "description": "AI-powered job search pipeline — works with any AI coding CLI (Claude Code, OpenCode, Gemini, Codex, Qwen)",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "reconcile": "node reconcile-pipeline.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node updater-migration-tests.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "validate:portals": "node validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
    "patterns": "node analyze-patterns.mjs",
    "newsletter": "node newsletter-monthly.mjs",
    "newsletter:dry": "NEWSLETTER_DRY_RUN=1 node newsletter-monthly.mjs",
    "newsletter:release": "node newsletter-product-update.mjs",
    "newsletter:release:dry": "NEWSLETTER_DRY_RUN=1 node newsletter-product-update.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "simulate:align": "node simulate-jd-align.mjs",
    "postinstall": "node -e \"if (process.env.VERCEL) process.exit(0)\" && (npx playwright install chromium --with-deps || npx playwright install chromium --with-deps)"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation"
  ],
  "author": "Akash Kaintura <akash.k96.official@gmail.com> (https://github.com/UGilfoyle)",
  "homepage": "https://github.com/UGilfoyle/career-ops",
  "repository": {
    "type": "git",
    "url": "https://github.com/UGilfoyle/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.19",
    "dotenv": "^17.0.0",
    "js-yaml": "^5.3.0",
    "playwright": "1.61.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0"
  }
}
