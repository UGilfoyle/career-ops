{
  "manifest_version": 3,
  "name": "CareerOps — 1-Click ATS Auto-Fill",
  "version": "1.0.1",
  "description": "Auto-fills job application forms on Ashby, Greenhouse, Lever, Workday, and LinkedIn using your CareerOps profile.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerOps ATS Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "resume.pdf"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}