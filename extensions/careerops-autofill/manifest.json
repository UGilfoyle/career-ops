{
  "manifest_version": 3,
  "name": "CareerOps — 1-Click ATS Auto-Fill",
  "version": "1.0.0",
  "description": "Auto-fills job application forms on Greenhouse, Lever, Workday, Ashby, and LinkedIn using your CareerOps profile.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.bamboohr.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.linkedin.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerOps ATS Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.bamboohr.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
