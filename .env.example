# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── LLM providers (GitHub Models is RETIRED as of 2026-07-30) ────────────────
# Official note: https://github.blog/changelog/2026-07-30-github-models-is-now-retired/
#
# Closest drop-in for old GitHub Models catalog IDs (openai/gpt-4o-mini):
#   https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
#
# Other OpenAI-compatible options (any one is enough):
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_API_KEY=...
# GROQ_MODEL=llama-3.3-70b-versatile
# TOGETHER_API_KEY=...
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# MODELSCOPE_API_KEY=...
# MODELSCOPE_MODEL=Qwen/Qwen2.5-72B-Instruct
#
# Google Gemini (also used by dashboard chat):
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
#
# Optional explicit custom endpoint (must NOT be models.github.ai):
# FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# FALLBACK_API_KEY=sk-or-v1-...
# FALLBACK_MODEL=openai/gpt-4o-mini
# Also copy into dashboard-v2/.env.local for the Next.js app.
#
# Optional: GitHub token for outreach research (personal PAT is fine; same as GITHUB_PAT).
# GITHUB_TOKEN=ghp_...
# GITHUB_PAT=ghp_...
#
# Optional: Upstash Redis REST (shared rate limits on Vercel). HTTPS URL + token, not redis:// TCP.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
#
# Tailor / apply priority:
#   OpenRouter → DeepSeek → Groq → Together → ModelScope → custom → Gemini
# Chat priority:
#   Gemini → OpenRouter → DeepSeek → Groq → Together → HuggingFace → custom
